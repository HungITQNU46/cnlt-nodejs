<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Trang chủ</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">

  <h1 class="text-center mb-4">Blog của tôi</h1>

  <div class="text-center mb-4">
    <a href="/blogposts/new" class="btn btn-success">+ Tạo bài viết</a>
  </div>

  <div class="row">
    <% posts.forEach(post => { %>
      <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title"><%= post.title %></h5>
            <p class="card-text">
              <%= post.body.substring(0, 100) %>...
            </p>

            <a href="/blogposts/<%= post._id %>" class="btn btn-primary btn-sm">Chi tiết</a>
            <a href="/blogposts/edit/<%= post._id %>" class="btn btn-warning btn-sm">Sửa</a>

            <form action="/blogposts/<%= post._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button class="btn btn-danger btn-sm">Xóa</button>
            </form>

          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>

</body>
</html>